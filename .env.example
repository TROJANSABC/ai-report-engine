# ---------- 搜索层 ----------
# tavily | serpapi | none
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ---------- LLM 层 ----------
# openai | anthropic | none
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- 采集参数 ----------
MAX_SOURCES=8
# 逗号分隔的 RSS 源（可选）
RSS_FEEDS=

# ---------- 存储 ----------
DB_PATH=reports.db
